# Secure Share Gateway Configuration
LISTEN_HOST=127.0.0.1
LISTEN_PORT=10029
PUBLIC_BASE_URL=https://share.example.com
STORAGE_DIR=/srv/secure-shares
PENDING_DIR=/srv/secure-shares/pending
KEY_PATH=/etc/mailcow-secure-share/master.key
LOG_PATH=/var/log/mailcow-secure-share/gateway.log
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
SESSION_EXPIRY_SECONDS=3600
EXPIRE_DAYS=60

# Outbound Filter Configuration
FILTER_LISTEN_PORT=10028
OUTBOUND_DELAY_SECONDS=80
BCC_CONVERT_THRESHOLD=10
